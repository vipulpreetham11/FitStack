VITE_SUPABASE_URL=
# email for development; phone for production after the Send SMS Hook is configured.
VITE_AUTH_MODE=email
# Prefer a Supabase publishable key. The legacy anon key is also supported.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
# Public gym logos only; private R2 URLs are signed by the server.
VITE_R2_PUBLIC_URL=
# Optional local preview. Never enables database access or production auth bypass.
VITE_ENABLE_PREVIEW=true
